# Copy this file to `.env.local` (or `.env`) and fill in real values.
# `.env*.local` and `.env` are gitignored — never commit secrets.

# Public site URL — used for canonical URLs, sitemap, robots.txt, llms.txt and OG tags.
# Required for `next build` (app/sitemap.ts hard-errors without it). On Vercel set it
# in Project Settings → Environment Variables; for local builds set it explicitly here.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
